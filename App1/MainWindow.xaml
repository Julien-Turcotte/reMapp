<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Key Swap">
    <StackPanel Spacing="10" Padding="16">
        <TextBlock Text="Key A" />
        <ComboBox x:Name="KeyABox" />
        <TextBlock Text="Key B" />
        <ComboBox x:Name="KeyBBox" />
        <ToggleButton x:Name="SwapToggle" Content="Swap: OFF" Click="OnSwapToggleClick" />
    </StackPanel>
</Window>
